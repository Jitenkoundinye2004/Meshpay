# MeshPay Backend Configuration Environment Variables

PORT=8080
JWT_SECRET=super_secret_meshpay_jwt_token_key_2026

# External AI Provider Configuration
# Set AI_API_KEY to your OpenAI or Gemini key to activate external LLM intelligence
AI_API_KEY=
AI_PROVIDER=openai # openai | gemini | mock
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# Node Environment
NODE_ENV=development
